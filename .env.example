# Souqna environment configuration
# Copy this file to `.env` and fill in your own values.
# Only variables prefixed with EXPO_PUBLIC_ are exposed to the app at runtime.

# Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (safe to ship in the client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# When "true", the app runs against in-memory mock data instead of Supabase.
# Defaults to mock mode automatically when the Supabase vars above are empty.
EXPO_PUBLIC_USE_MOCKS=true
